diff --git a/pkg/autostart/launchd/plist_xml_test.go b/pkg/autostart/launchd/plist_xml_test.go
new file mode 100644
index 00000000..182aee5f
--- /dev/null
+++ b/pkg/autostart/launchd/plist_xml_test.go
@@ -0,0 +1,68 @@
+// SPDX-FileCopyrightText: Copyright The Lima Authors
+// SPDX-License-Identifier: Apache-2.0
+
+package launchd
+
+import (
+	"bytes"
+	"encoding/xml"
+	"io"
+	"strings"
+	"testing"
+
+	"github.com/lima-vm/lima/v2/pkg/textutil"
+)
+
+// TestPlistTemplatesEscapeDynamicValues renders both launchd plist templates with values that
+// contain XML metacharacters and checks that the result is well-formed XML whose decoded values
+// are unchanged. Both templates are rendered through textutil.ExecuteTemplate, the same path the
+// CLI's renderDaemonPlist and the autostart manager's renderTemplate take.
+func TestPlistTemplatesEscapeDynamicValues(t *testing.T) {
+	vars := map[string]string{
+		"Instance":  `inst&<>"'`,
+		"UserName":  `user&<>`,
+		"LimaHome":  `/Users/a/R&D/<home>`,
+		"Binary":    `/opt/a&b/<lima>/limactl`,
+		"WorkDir":   `/work/a&'b"/<dir>`,
+		"Path":      `/usr/bin:/opt/a&b:/r<s>`,
+		"KeepAlive": "true",
+	}
+	for name, tmpl := range map[string]string{"LaunchAgent": Template, "LaunchDaemon": DaemonTemplate} {
+		t.Run(name, func(t *testing.T) {
+			out, err := textutil.ExecuteTemplate(tmpl, vars)
+			if err != nil {
+				t.Fatalf("render: %v", err)
+			}
+			decoded := strings.Join(decodeCharData(t, out), "\n")
+			for _, key := range []string{"Instance", "LimaHome", "Binary", "WorkDir", "Path"} {
+				if !strings.Contains(decoded, vars[key]) {
+					t.Errorf("%s value %q did not round-trip through the rendered plist", key, vars[key])
+				}
+			}
+		})
+	}
+}
+
+// decodeCharData returns the character data of an XML document, failing the test if the document
+// is not well-formed. The decoder unescapes entities, so a value that was escaped correctly comes
+// back identical to the input; an unescaped '&' or '<' makes the document fail to parse.
+func decodeCharData(t *testing.T, doc []byte) []string {
+	t.Helper()
+	dec := xml.NewDecoder(bytes.NewReader(doc))
+	var out []string
+	for {
+		tok, err := dec.Token()
+		if err == io.EOF {
+			break
+		}
+		if err != nil {
+			t.Fatalf("rendered plist is not well-formed XML: %v\n%s", err, doc)
+		}
+		if cd, ok := tok.(xml.CharData); ok {
+			if s := strings.TrimSpace(string(cd)); s != "" {
+				out = append(out, s)
+			}
+		}
+	}
+	return out
+}
diff --git a/pkg/textutil/textutil.go b/pkg/textutil/textutil.go
index 29d4d1bd..4ee77197 100644
--- a/pkg/textutil/textutil.go
+++ b/pkg/textutil/textutil.go
@@ -6,17 +6,20 @@ package textutil
 import (
 	"bytes"
 	"encoding/json"
+	"encoding/xml"
 	"errors"
 	"fmt"
 	"strings"
 	"text/template"
+	"unicode/utf8"
 
 	"github.com/goccy/go-yaml"
 )
 
-// ExecuteTemplate executes a text/template template.
+// ExecuteTemplate executes a text/template template with TemplateFuncMap registered,
+// so templates such as the launchd plists can escape dynamic values with the "xml" function.
 func ExecuteTemplate(tmpl string, args any) ([]byte, error) {
-	x, err := template.New("").Parse(tmpl)
+	x, err := template.New("").Funcs(TemplateFuncMap).Parse(tmpl)
 	if err != nil {
 		return nil, err
 	}
@@ -111,6 +114,20 @@ var TemplateFuncMap = template.FuncMap{
 		}
 		return MissingString(message, text), nil
 	},
+	"xml": func(s string) (string, error) {
+		// Escape a value for inclusion in an XML document such as a launchd plist.
+		// Rejecting invalid UTF-8 avoids silently substituting U+FFFD and thereby changing
+		// a value such as a filesystem path; EscapeText handles '&', '<', '>', quotes and
+		// carriage returns.
+		if !utf8.ValidString(s) {
+			return "", fmt.Errorf("value is not valid UTF-8: %q", s)
+		}
+		var b bytes.Buffer
+		if err := xml.EscapeText(&b, []byte(s)); err != nil {
+			return "", err
+		}
+		return b.String(), nil
+	},
 }
 
 // FuncHelp is help for TemplateFuncMap.
